{
  "name": "@yldfi/curve-amm-math",
  "version": "1.9.0",
  "packageManager": "pnpm@11.5.1",
  "description": "Exact, on-chain-verified TypeScript ports of Curve AMM math (StableSwap, CryptoSwap, NG, metapools) for off-chain quotes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.mjs",
      "require": "./dist/rpc/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/__fixtures__"
  ],
  "scripts": {
    "build": "tsdown",
    "check:compat": "node scripts/compat/api.mjs && node scripts/compat/math.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -c 'pnpm type-check'"
    ]
  },
  "keywords": [
    "curve",
    "defi",
    "amm",
    "stableswap",
    "stableswap-ng",
    "cryptoswap",
    "tricrypto",
    "twocrypto",
    "metapool",
    "liquidity",
    "vyper",
    "math",
    "ethereum"
  ],
  "author": "michaeldim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yldfi/curve-amm-math.git"
  },
  "bugs": {
    "url": "https://github.com/yldfi/curve-amm-math/issues"
  },
  "homepage": "https://github.com/yldfi/curve-amm-math#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsdown": "0.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
